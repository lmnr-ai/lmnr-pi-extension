{
  "name": "lmnr-pi-extension",
  "version": "0.1.0",
  "description": "Laminar observability extension for the pi coding agent — live in-process OTLP tracing",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": ["pi-package", "pi", "laminar", "observability", "tracing", "otel", "otlp"],
  "files": ["src", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "pi": {
    "extensions": ["src/index.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@lmnr-ai/lmnr": "^0.8.40",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
